# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# Required. Free developer key: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Optional. Any model available to your Ollama instance.
OLLAMA_MODEL=mistral:7b

# Optional. Only needed when running the app outside Docker against a remote Ollama.
# OLLAMA_BASE_URL=http://localhost:11434

# Optional. Switch summarization to a hosted model when a small local one will not
# honour the structured-output schema. Leave as-is to keep everything on this machine.
# SUMMARIZATION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional. Overrides the archive database password used by docker compose.
# DB_PASSWORD=newsbrief
